{
  "experiment_name": "ZULF_Spectral_Resolution_Example",
  "metadata": {
    "operator": "DM Technologies",
    "sample": "13C-Formic Acid",
    "temperature_C": 25.0,
    "notes": "Two lines 10 Hz apart (CH1 227 Hz, CH3 217 Hz) and a low line (CH2 22 Hz): select less than 0.1 s of a trace to see the two close lines merge; the average of 6 transients shows lower peaks than a single transient"
  },
  "output": {
    "average_count": 6,
    "format": "csv",
    "auto_save": true
  },
  "hardware_parameters": {
    "acq_sample_rate_hz": 1000
  },
  "acquisition": {
    "start": 1000,
    "number_of_samples": 20000,
    "channels": [1, 2, 3]
  },
  "events": [
    {
      "time_ms": 0,
      "action": ":SHIM:CURRent 1, 2.5"
    },
    {
      "time_ms": 0,
      "action": ":SHIM:CURRent 2, -100.0"
    },
    {
      "time_ms": 0,
      "action": ":SHIM:CURRent 3, -2.5"
    },
    {
      "time_ms": 50,
      "action": ":MOTor:MOVE MAGNET"
    },
    {
      "time_ms": 100,
      "action": ":DIGital:STATe 2, 1"
    },
    {
      "time_ms": 200,
      "action": ":DIGital:STATe 2, 0"
    },
    {
      "time_ms": 10000,
      "action": ":MOTor:MOVE MEASURE"
    },
    {
      "time_ms": 10400,
      "action": ":AWG:RUN"
    }
  ],
  "awg_sequence": {
    "type": "npz",
    "file_path": "sequences/thermal_pulses.npz"
  }
}
